#compdef btcvm imgfs imgfs.py
# btcvm + imgfs zsh tab completions
# Install:
#   cp completions/_btcvm ~/.zsh/completions/_btcvm
#   Add to ~/.zshrc:  fpath=(~/.zsh/completions $fpath)
#   Then run:         compinit  (or restart shell)

# ── btcvm ─────────────────────────────────────────────────────────────────────

_btcvm() {
    local -a opts
    opts=(
        '--once[Run for a single block then exit]'
        '--trace[Enable trace Merkle mode (v2)]'
        '--vdf-ticks[VDF sub-clock ticks per block]:ticks:(5 10 20 50 100)'
        '--vms[Number of parallel VMs (fleet mode)]:count:(2 4 8 16)'
        '--help[Show help]'
    )
    _arguments $opts
}

# ── imgfs helpers ─────────────────────────────────────────────────────────────

_imgfs_manifest_names() {
    local -a names
    if [[ -f imgfs_manifest.jsonl ]]; then
        names=( ${(f)"$(python3 -c "
import json
try:
    with open('imgfs_manifest.jsonl') as f:
        for line in f:
            line = line.strip()
            if line:
                e = json.loads(line)
                print(e.get('name',''))
except: pass
" 2>/dev/null)"} )
    fi
    compadd -a names
}

_imgfs_video_names() {
    local -a names
    if [[ -f imgfs_manifest.jsonl ]]; then
        names=( ${(f)"$(python3 -c "
import json
try:
    with open('imgfs_manifest.jsonl') as f:
        for line in f:
            line = line.strip()
            if line:
                e = json.loads(line)
                if e.get('type') == 'video':
                    print(e.get('name',''))
except: pass
" 2>/dev/null)"} )
    fi
    compadd -a names
}

_imgfs_chunk_indices() {
    local vfile="$1"
    local -a indices
    if [[ -f imgfs_manifest.jsonl ]]; then
        local n
        n=$(python3 -c "
import json
try:
    with open('imgfs_manifest.jsonl') as f:
        for line in f:
            line = line.strip()
            if line:
                e = json.loads(line)
                if e.get('name') == '$vfile':
                    print(e.get('n_chunks', 1))
except: pass
" 2>/dev/null)
        if [[ -n "$n" ]]; then
            indices=( $(seq 0 $(( n - 1 ))) )
        fi
    fi
    compadd -a indices
}

# ── imgfs main completion ─────────────────────────────────────────────────────

_imgfs() {
    local state

    _arguments \
        '1:subcommand:->subcommand' \
        '*:args:->args' \
        && return

    case $state in
        subcommand)
            local -a subcommands
            subcommands=(
                'add:Add images or video to the archive'
                'status:Show archive status and current Merkle root'
                'commit:Commit Merkle root to btcvm ledger'
                'list:List all archived files'
                'verify:Verify file inclusion with Merkle proof'
                'verify-chunk:Prove byte-range inclusion for a video chunk'
            )
            _describe 'subcommand' subcommands
            ;;
        args)
            case ${words[2]} in
                add)
                    _files
                    ;;
                verify)
                    _imgfs_manifest_names
                    ;;
                verify-chunk)
                    if (( CURRENT == 3 )); then
                        _imgfs_video_names
                    elif (( CURRENT == 4 )); then
                        _imgfs_chunk_indices "${words[3]}"
                    fi
                    ;;
            esac
            ;;
    esac
}

compdef _btcvm btcvm
compdef _imgfs imgfs
compdef _imgfs imgfs.py
